{
  "name": "Captura de Página Inteira",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "Capture páginas inteiras com fidelidade e copie a imagem para a área de transferência.",
  "action": {
    "default_icon": "icon-999.png",
    "default_popup": "popup.html",
    "default_title": "Capturar página inteira"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Capturar a página inteira"
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "icons": {
    "16": "icon16-999.png",
    "48": "icon48-999.png",
    "128": "icon128-999.png"
  }
}
